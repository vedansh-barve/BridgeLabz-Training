-- DATABASE - practice_db;

------------ Insert Patient Into DB-----------

mysql> CREATE TABLE Patient ( 
	patientID INT AUTO_INCREMENT PRIMARY KEY, 
	name VARCHAR(50) NOT NULL, 
	dob DATE NOT NULL, 
	contact VARCHAR(15) UNIQUE NOT NULL, 
	address VARCHAR(100) NOT NULL, 
	blood_group ENUM('A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-') NOT NULL
);

o/p -> Query OK, 0 rows affected

mysql> INSERT INTO Patient
	(name, dob, contact, address, blood_group) 
	VALUES("Ravi", "2026-02-09", "7373738392", "Indrapuri", 'O+');
	
mysql> INSERT INTO Patient
	(name, dob, contact, address, blood_group) 
	VALUES("Ritesh", "2026-02-10", "8448738392", "Piplani", 'A+');
	
mysql> INSERT INTO Patient
	(name, dob, contact, address, blood_group) 
	VALUES("Shriyansh", "2026-02-08", "6348738392", "Narela", 'A-');	
	
o/p -> Query OK, 1 row affected


