mysql> SELECT d.doctor_id, d.doctor_name, 
	s.speciality_name, sch.available_day, 
	sch.time_slot FROM doctors d 
	JOIN specialities s ON d.speciality_id = s.speciality_id 
	JOIN doctor_schedule sch ON d.doctor_id = sch.doctor_id 
	WHERE s.speciality_name = 'Cardiology' AND d.is_active = TRUE;

+-----------+-------------+-----------------+---------------+-------------+
| doctor_id | doctor_name | speciality_name | available_day | time_slot   |
+-----------+-------------+-----------------+---------------+-------------+
|         1 | RAVI        | Cardiology      | Thrusday      | 12:00-15:00 |
|         4 | Shriyansh   | Cardiology      | Tuesday       | 9:00-12:00  |
+-----------+-------------+-----------------+---------------+-------------+
2 rows in set (0.02 sec)


mysql> UPDATE doctors SET is_active = false where doctor_id = 3 AND doctor_id NOT IN(SELECT doctor_id FROM appointments  WHERE appointment_date > CURDATE());
