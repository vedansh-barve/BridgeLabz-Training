-- doctors, appointments



mysql> CREATE TABLE specialities(
 	speciality_id INT PRIMARY KEY AUTO_INCREMENT, 
 	speciality_name VARCHAR(100) UNIQUE NOT NULL);
 	
o/p -> Query OK, 0 rows affected (0.38 sec)


mysql> CREATE TABLE doctors(
	doctor_id INT PRIMARY KEY AUTO_INCREMENT, 
	doctor_name VARCHAR(100) NOT NULL, 
	contact VARCHAR(15) UNIQUE, 
	consultation_fee DECIMAL(8, 2), speciality_id INT, 
	is_active BOOLEAN DEFAULT TRUE, 
	FOREIGN KEY (speciality_id) REFERENCES specialities(speciality_id));
	
	
o/p -> Query OK, 0 rows affected (0.22 sec)
	
	
mysql> CREATE TABLE doctor_schedule(
	schedule_id INT PRIMARY KEY AUTO_INCREMENT, 
	doctor_id INT NOT NULL, 
	available_day VARCHAR(15), 
	time_slot VARCHAR(15), 
	FOREIGN KEY (doctor_id) REFERENCES doctors(doctor_id));
	
o/p -> Query OK, 0 rows affected (0.40 sec)


mysql> CREATE TABLE appointments(
	appointment_id INT PRIMARY KEY AUTO_INCREMENT, 
	doctor_id INT NOT NULL, 
	appointment_date DATE NOT NULL, 
	FOREIGN KEY (doctor_id) REFERENCES doctors(doctor_id));
	
o/p -> Query OK, 0 rows affected (0.09 sec)


